# Neon serverless Postgres connection string
# https://neon.tech -> project -> Connection Details
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/batchmates?sslmode=require"

# Auth.js v5 — generate with `npx auth secret`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth app (console.cloud.google.com -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth app (github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Judge0 — code execution engine
# Self-hosted: http://your-server:2358 or Judge0 CE: https://judge0-ce.p.rapidapi.com
# Leave empty for mock mode (returns fake "Accepted" responses)
JUDGE0_URL=""
JUDGE0_AUTH_TOKEN=""

# Google Gemini — AI hints
# Leave empty for static fallback hints
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# PartyKit — realtime room server
# Leave empty to use mock presence/chat
NEXT_PUBLIC_PARTYKIT_HOST=""

# Vercel Cron — secret for authenticating cron requests
CRON_SECRET=""
